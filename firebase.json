{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": [{
    "bucket": "precast-qc-tools-web-app.firebasestorage.app",
    "rules": "storage.rules"
  }],
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/feedback",
        "function": "feedbackPage"
      },
      {
        "source": "/api/submitFeedback",
        "function": "submitEngineerFeedback"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|gif|png|svg|webp|js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=31536000"
          }
        ]
      }
    ]
  }
}
