rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper function to check if user is authenticated and approved
    function isApproved() {
      return request.auth != null;
    }

    // Quality log photos (legacy path)
    match /qualityLogs/{logId}/{fileName} {
      allow read: if isApproved();
      allow write: if isApproved() &&
                     request.resource.size < 10 * 1024 * 1024 && // 10MB max
                     request.resource.contentType.matches('image/.*');
    }

    // Quality log attachments (new path used by dashboard)
    match /quality-log-attachments/{entryId}/{fileName} {
      allow read: if isApproved();
      allow write: if isApproved() &&
                     request.resource.size < 10 * 1024 * 1024; // 10MB max
    }

    // Quality log attachments - nested subfolder for slippage reports
    match /quality-log-attachments/{entryId}/{subFolder}/{fileName} {
      allow read: if isApproved();
      allow write: if isApproved() &&
                     request.resource.size < 10 * 1024 * 1024; // 10MB max
    }

    // Project blueprints and drawings
    match /project-blueprints/{projectId}/{fileName} {
      allow read: if isApproved();
      allow write: if isApproved() &&
                     request.resource.size < 50 * 1024 * 1024; // 50MB max for blueprints/PDFs
    }

    // Calibration reports
    match /calibrations/{reportId}/{fileName} {
      allow read: if isApproved();
      allow write: if isApproved() &&
                     request.resource.size < 20 * 1024 * 1024; // 20MB max
    }

    // General attachments
    match /attachments/{userId}/{fileName} {
      allow read: if isApproved();
      allow write: if isApproved() &&
                     request.auth.uid == userId &&
                     request.resource.size < 10 * 1024 * 1024;
    }
  }
}
