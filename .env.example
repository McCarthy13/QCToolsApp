# Firebase Configuration (Web App Build)
# Get these from Firebase Console > Project Settings > General
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# Firebase Service Account (Deployment)
# Get from Firebase Console > Project Settings > Service Accounts > Generate New Private Key
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PROJECT_NUMBER=your_firebase_project_number

# API Keys (Firebase Functions)
# Get from respective AI provider dashboards
ANTHROPIC_API_KEY=sk-ant-api03-your_anthropic_key_here
OPENAI_API_KEY=sk-proj-your_openai_key_here

# GitHub Configuration (for CI/CD)
GITHUB_TOKEN=ghp_your_github_token_here

# Microsoft 365 / SharePoint Configuration
EXPO_PUBLIC_MICROSOFT_CLIENT_ID=your_azure_client_id_here
EXPO_PUBLIC_MICROSOFT_TENANT_ID=your_azure_tenant_id_here
EXPO_PUBLIC_SHAREPOINT_SITE_URL=https://yourcompany.sharepoint.com/sites/YourSite
EXPO_PUBLIC_SHAREPOINT_LIBRARY=Shared Documents
EXPO_PUBLIC_SHAREPOINT_FOLDER_PATH=/Your/Folder/Path

# Azure Document Intelligence (for PDF/document processing)
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=your_azure_doc_intelligence_key_here
