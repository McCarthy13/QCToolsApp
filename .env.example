# Firebase Configuration (Web App Build)
# Get these from Firebase Console > Project Settings > General
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# Firebase Service Account (Deployment)
# Get from Firebase Console > Project Settings > Service Accounts > Generate New Private Key
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your_project_id",...}

# API Keys (Firebase Functions)
# Get from respective AI provider dashboards
ANTHROPIC_API_KEY=sk-ant-api03-your_anthropic_key_here
OPENAI_API_KEY=sk-proj-your_openai_key_here

# GitHub Configuration (for CI/CD)
GITHUB_TOKEN=ghp_your_github_token_here
